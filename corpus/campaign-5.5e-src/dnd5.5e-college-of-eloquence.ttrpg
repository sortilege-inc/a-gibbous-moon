EXTENSION "AGibbousMoon_Campaign_Subclasses" EXTENDS "Dnd5_5e_Core_Base" {
    NAME "A Gibbous Moon — Campaign Subclasses (converted to 5.5e)"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-08-16"

    # College of Eloquence (Bard). Source: Mythic Odysseys of Theros / Tasha's
    # Cauldron of Everything (5e), owner-provided. Converted to SRD 5.2.1 (2024)
    # conventions per the same guide used for Historica (capitalization applied;
    # rules text otherwise verbatim). Feature levels kept as published:
    # 3 / 3 / 6 / 6 / 14.
    #
    # OPEN (owner decisions, not invented here):
    #  - 2024 Bard subclasses grant features at 3/6/10/14; Eloquence has NO
    #    level-10 feature. Left as a gap rather than inventing one.
    #  - Universal Speech activates "as an action"; 2024 would phrase a magical
    #    feature's activation as the Magic action. Kept verbatim pending sign-off.

#tEloquenceCollege000001 ^"Bard - College of Eloquence" DEF {
    EXTENDS ^"Subclass"
    PROPERTIES {
        ^"Parent Class" STRING "Bard"
        ^"Description" STRING "Adherents of the College of Eloquence master the art of oratory. Persuasion is regarded as a high art, and a well-reasoned, well-spoken argument often proves more powerful than objective truth. These bards wield a blend of logic and theatrical wordplay, winning over skeptics and detractors with logical arguments, and plucking at heartstrings to appeal to the emotions of entire audiences."
    }
    FEATURES {
        #tEloquenceSilverTongue1 ^"Silver Tongue" DEF {
            EXTENDS ^"Subclass Feature"
            ^"Level" INTEGER 3
            ^"Description" STRING "Starting at 3rd level, you are a master at saying the right thing at the right time. When you make a Charisma (Persuasion) or Charisma (Deception) check, you can treat a d20 roll of 9 or lower as a 10."
        }
        #tEloquenceUnsettling001 ^"Unsettling Words" DEF {
            EXTENDS ^"Subclass Feature"
            ^"Level" INTEGER 3
            ^"Description" STRING "Also at 3rd level, you can spin words laced with magic that unsettle a creature and cause it to doubt itself. As a Bonus Action, you can expend one use of your Bardic Inspiration and choose one creature you can see within 60 feet of you. Roll the Bardic Inspiration die. The creature must subtract the number rolled from the next saving throw it makes before the start of your next turn."
        }
        #tEloquenceUnfailing0001 ^"Unfailing Inspiration" DEF {
            EXTENDS ^"Subclass Feature"
            ^"Level" INTEGER 6
            ^"Description" STRING "At 6th level, your inspiring words are so persuasive that others feel driven to succeed. When a creature adds one of your Bardic Inspiration dice to its ability check, attack roll, or saving throw and the roll fails, the creature can keep the Bardic Inspiration die."
        }
        #tEloquenceUniversal0001 ^"Universal Speech" DEF {
            EXTENDS ^"Subclass Feature"
            ^"Level" INTEGER 6
            ^"Description" STRING "Also at 6th level, you have gained the ability to make your speech intelligible to any creature. As an action, choose one or more creatures within 60 feet of you, up to a number equal to your Charisma modifier (minimum of one creature). The chosen creatures can magically understand you, regardless of the language you speak, for 1 hour.\n\nOnce you use this feature, you can't use it again until you finish a Long Rest, unless you expend a spell slot to use it again."
        }
        #tEloquenceInfectious001 ^"Infectious Inspiration" DEF {
            EXTENDS ^"Subclass Feature"
            ^"Level" INTEGER 14
            ^"Description" STRING "At 14th level, when you successfully inspire someone, the power of your eloquence can now spread to someone else. When a creature within 60 feet of you adds one of your Bardic Inspiration dice to its ability check, attack roll, or saving throw and the roll succeeds, you can use your Reaction to encourage a different creature (other than yourself) that can hear you within 60 feet of you, giving it a Bardic Inspiration die without expending any of your Bardic Inspiration uses.\n\nYou can use this Reaction a number of times equal to your Charisma modifier (minimum of once), and you regain all expended uses when you finish a Long Rest."
        }
    }
}
}
