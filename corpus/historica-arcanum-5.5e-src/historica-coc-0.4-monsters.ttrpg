#teqN9xt0fWFtu7Tl9Mvdy8SI ^"Armsmaster" DEF {
    EXTENDS ^"Monster"
    PROPERTIES {
        ^"Name" STRING "Armsmaster"
        ^"Size" STRING "Medium"
        ^"Type" STRING "humanoid"
        ^"Alignment" STRING "any alignment"
        ^"Abilities" DEF {
            ^"Strength" INTEGER 14
            ^"Dexterity" INTEGER 16
            ^"Constitution" INTEGER 14
            ^"Intelligence" INTEGER 10
            ^"Wisdom" INTEGER 13
            ^"Charisma" INTEGER 11
        }
        ^"Armor Class" STRING "16 (Chain Mail)"
        ^"Hit Points" INTEGER 52
        ^"Hit Dice" STRING "8d8 + 16"
        ^"Speed" STRING "30 ft."
        ^"Saving Throws" STRING "Str +4, Con +4"
        ^"Skills" STRING "Athletics +4"
        ^"Senses" STRING "Passive Perception 11"
        ^"Challenge Rating" STRING "3"
        ^"Experience Points" INTEGER 700
    }
    FEATURES {
        #t02SdjsW8A9LNVvGaKkFYqjs ^"Good Aim" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "The armsmaster has +2 bonus to attack rolls made with firearms (included in Actions)."
        }
        #tKptFUDRa59PIK78hB5RPi9d ^"Multiattack" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "The armsmaster can make two attacks with any combination."
        }
        #trIYwUgAJzLr3uXyycNTZGP1 ^"Yatagan" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "*Melee Weapon Attack:* +4 to hit, reach 5 ft. one target. Hit 6 (1d8 + 2) Slashing damage, or 7 (1d10 + 2) Slashing damage if used with two hands."
        }
        #thFZ90oq2JlEu3TgI23laSVd ^"Repeating Handgun" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "*Ranged Weapon Attack:* +7 to hit, range 120/300 ft., one target. Hit: 7 (1d6+3) Piercing damage."
        }
        #tfQjpu9QmSTUGjhcg8TtMabQ ^"Tüfeq" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "*Ranged Weapon Attack:* +7 to hit, reach 250/750 ft., one target. Hit: 9 (1d8+3) Piercing damage. (Reroll on a roll of 8 and add the damage)"
        }
        #tpK8jGJ9UCLxhtquGU6HMZTg ^"Humbara Bomb" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "It can be thrown up to 40 feet as an action. Any creature within a 10 foot radius of the impact must succeed on a DC 13 Dexterity saving throw. On a failed save they take 15 (5d6) Fire damage or half as much on a successful one. Flammable objects catch fire in the radius."
        }
    }
}

