        #tBJj3YpARhSh3BCiBDRnoyxW ^"Sense the Sinner" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "The naziat will sense any evil alignment creature, any undead and any fiend within 60 ft. The naziat will not know the potency of their powers, but it will know their numbers in detail. When the naziat sees a creature, it can force the creature to make a DC 14 Charisma saving throw. On a failed save, the naziat knows the creature's alignment."
        }
        #tPCXrQlUS47DuCAeyirdqIHm ^"End of All Things" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "No undead or fiend slain by the naziat will return; it will be utterly, permanently destroyed."
        }
        #tDb5M6yOYr5TCNol8ZXJafkF ^"Aura of Dread" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "As a Reaction the naziat will activate its dread aura. Any evil creature in a 10 ft. area will take 3 (1d6) Radiant damage for each turn spent in the area and it can’t regain Hit Points while they are still in this area. This aura persists for one minute and the Naziat will regain its use when it performs a Short Rest."
        }
        #t15DwfxMW6lT5fKq9aJvKFzC ^"Angelic Prowess" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "When the naziat is subjected to any effect which allows it to make a Constitution saving throw to take only half damage, it instead takes no damage if it succeeds on the saving throw and only half damage if it fails."
        }
        #traSF6GDmU6c0MWijYkbgudD ^"Reaping Scythe" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "Melee Weapon Attack: +8 to hit, reach 5 ft., one creature. Hit 16 (3d6+5) Slashing damage. The target needs to make a Constitution save on DC 12, or the target’s hit point maximum is reduced by the amount of damage taken. Lost Hit Points will be regained after a Long Rest or with a greater restoration spell. If a creature is brought to 0 HP by Reaping Scythe, the creature cannot be brought back to life with any kind of magic."
        }
    }
}

