#tNqB04eY0zSdrBrx8xrvdf4G ^"Kabadayi" DEF {
    EXTENDS ^"Monster"
    PROPERTIES {
        ^"Name" STRING "Kabadayi"
        ^"Size" STRING "Medium"
        ^"Type" STRING "humanoid"
        ^"Alignment" STRING "any lawful alignment"
        ^"Abilities" DEF {
            ^"Strength" INTEGER 16
            ^"Dexterity" INTEGER 14
            ^"Constitution" INTEGER 14
            ^"Intelligence" INTEGER 10
            ^"Wisdom" INTEGER 10
            ^"Charisma" INTEGER 16
        }
        ^"Armor Class" STRING "13 (Leather Armor)"
        ^"Hit Points" INTEGER 26
        ^"Hit Dice" STRING "4d8 + 8"
        ^"Speed" STRING "30 ft."
        ^"Saving Throws" STRING "Str +5"
        ^"Skills" STRING "Athletics +5"
        ^"Senses" STRING "Passive Perception 10"
        ^"Challenge Rating" STRING "1/2"
        ^"Experience Points" INTEGER 100
    }
    FEATURES {
        #ts0pzQH12gcgN81bJQIXzHIb ^"Rage" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "The kabadayi can enter a rage using a Bonus Action 2 times a day. While in rage, the kabadayi has the following features:\n• Has resistance to bludgeoning, piercing and Slashing damage.\n• Has +2 bonus to damage rolls with melee attacks using Strength.\n• Advantage on Strength checks and Strength saving throws.\nRage lasts for 1 minute. It ends early if the kabadayi hasn’t attacked against a hostile creature since its last turn or taken damage since then. He can’t cast or concentrate spells while raging."
        }
        #tlvJUVdDLf4lAI6vuLtpNycJ ^"Wrath of the Vagabond" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "The kabadayi’s rage invokes fear in the hearts of his enemies. This fear can affect 3 creatures that it can see. The targets must succeed on a Wisdom saving throw (DC 13) or be frightened for 1 minute. He can use this feature once per rage. The effected creatures can repeat the saving throw at the end of their turns."
        }
