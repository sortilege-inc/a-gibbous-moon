            ^"Category" STRING "Action"
            ^"Description" STRING "Abra can use its Aura of Dread. It then makes 3 attacks: one with its bite and two with its claws."
        }
        #tcl4NdSTk0dS8zOU40RcnRaY ^"Bite" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "*Melee Weapon Attack:* +14 to hit, reach 10 ft., one creature. Hit: 21 (2d12 + 9) Piercing damage."
        }
        #t8f4f32jjpx9wfYDPZ7mTzro ^"Claws" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "*Melee Weapon Attack:* +14 to hit, reach 5 ft., one creature. Hit: 25 (3d10 + 9) Slashing damage."
        }
        #tVRIZhGnHJxOIBW8N7ONaCMg ^"Tail Swipe" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "*Melee Weapon Attack:* +14 to hit, reach 15 ft., multiple creatures in the range. Hit: 19 (2d10 + 9) Bludgeoning damage All targets make a Strength saving throw (DC 21) or fall prone."
        }
        #tTAh8mzBvN5wxADJTkmkmWRI ^"Aura of Dread" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "Each creature of Abra's choice that is within 120 feet of it and aware of it must succeed on a Wisdom saving throw (DC 21) or become Frightened for 1 minute. A creature can repeat this saving throw at the end of each of its turns, ending the effect on itself on a success. If a creature's saving throw is successful or the effect ends for it, the creature is immune to Abra's Aura of Dread for the next 24 hours."
        }
        #tpSrqzJcTcg6YfxhAKluNKy1 ^"Breath Weapons (Recharge 5-6)" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "Abra can use one of the following breath weapons."
        }
        #tVzENX8LYg51U8l2L018iTlt ^"Legendary Wrath" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "Abra exhales fire and radiant energy in a 60-foot cone. Each creature in that area must make a dexterity saving throw (DC 21) or take 32 (6d10) Fire damage and 32 (6d10) Radiant damage on a failed save, or half as much on (both) a successful save."
        }
        #tZz2z79i6P6gqMHztDJjJtY1 ^"Disabling Cloud" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "Abra exhales gas in a 60foot cone. Each creature in that area must succeed on a constitution saving throw (DC 21) or fall unconscious for 10 minutes unless damaged or shaken to wake up. Even if the save is made all attack rolls, saving throws and skill checks are made with a Disadvantage for 10 minutes."
        }
        #tU0GXC8jEaOe4FCx1NAzoDsB ^"Shapechange" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "Abra magically polymorphs into a humanoid or beast that has a challenge rating no higher than its own, or back into its true form. It reverts to its true form if it dies. Any equipment it is wearing or carrying is absorbed into the new form. In the new form Abra retains its alignment, Hit Points, Hit Point Dice, ability to speak, proficiencies, Legendary Resistance, intelligence, wisdom and charisma scores, as well as this action. Its statistics and capabilities are otherwise replaced by those of the new form, except any class features or legendary actions of that form."
        }
        #tLkC8V0KoDoR97PiKDybyY4v ^"Absorb Magical Anomaly" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Legendary Action"
            ^"Description" STRING "Abra can detect the lingering Terrestrial Repercussion effect of any rebound magic and can feed and heal itself by canceling that effect. Abra heals itself by 25 Hit Points when absorbing this effect. If Abra is at maximum Hit Points, instead Abra gains 25 Temporary Hit Points. Abra can feed from a Terrestrial Repercussion effect remotely and it can be as far as six miles away."
        }
        #tBYMgRt7B11ueW8neUs8tm8e ^"Tail Swipe" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Legendary Action"
            ^"Description" STRING "(Costs 2 Actions) Abra makes a tail swipe attack."
        }
        #twYIqiat4jpPxiSsEGic2IgE ^"Wing Attack" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Legendary Action"
            ^"Description" STRING "(Cost 2 Actions) Abra beats its wings. Each creature within 10 feet of Abra must succeed on a dexterity saving throw (DC 18) or take 15 (2d6+9) Bludgeoning damage and be knocked prone. Abra can fly up to half its flying speed."
        }
    }
}

