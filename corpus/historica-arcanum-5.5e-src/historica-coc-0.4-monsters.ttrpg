        ^"Challenge Rating" STRING "3"
        ^"Experience Points" INTEGER 700
    }
    FEATURES {
        #tYNym3HIPZbUvbuBOB2UuMPW ^"Ichor Carapace" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "The obur has a hard carapace-like skin, coated with acidic ichor. When a creature touches the obur or hits it with a melee attack while within 5 feet of it, the creature takes 3 (1d6) Acid damage."
        }
        #tHmQ3PX0ORRaOswIXCPNKtAc ^"Extended Tongue" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "Melee Weapon Attack: +6 to hit, reach 10 ft., one target. Hit: 7 (1d6+4) Piercing damage and the target must succeed on a Constitution save (DC 12) or take 9 (3d6) Poison damage and become Poisoned for 1 minute. The target can repeat its saving throw at the end of each of its turns to break free from this effect. The target is also grappled (Escape DC16). Until the grapple ends, the target is Restrained, and the obur can't bite another target."
        }
        #tIhDzAZuerDc08KUMEOEdNYK ^"Swallow Whole" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "The obur makes another attack against a medium or smaller target it is already grappling. If this attack hits, the target is swallowed, and the grapple condition ends. The swallowed target is Blinded and restrained, it has cover against attacks and other effects outside the obur, and it takes 15 (5d6) Acid damage at the start of the obur's turns. The obur can have only one target swallowed at a time. If the obur dies, a swallowed creature is no longer Restrained by it and can escape from the corpse using 5 feet of movement, exiting prone."
        }
    }
}

