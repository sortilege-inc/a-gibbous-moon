        }
        #tRRdE3WZMZhh1na6xWrLCaHg ^"Fortune-telling" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "The muneccim have the Fortune-telling feat."
        }
        #t91Cztnfu1P8XnNypVYg9aYH ^"Omens from the Sky (4/day)" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Trait"
            ^"Description" STRING "The muneccim can touch a creature to grant them one of the abilities below, that is active for 1 minute. Once used, the ability is lost. A creature can’t have more than one benefit active on them at the same time. The muneccim can regain a use of it by expending a spell slot (action required)\nBad Omen: When the creature is hit by an attack, it can use its Reaction to roll a d10 and deduct it from the roll, potentially causing it to miss. Good Omen: When the creature misses an attack roll, it can use its Reaction to roll a d10 and add it to their attack roll, potentially causing it to hit. Magical Surge: When the creature casts a spell that is 3rd level or lower and expends a spell slot, it can use its Reaction to make a spellcasting ability check. DC is equal to 10 + spell’s level. On a success, the spell slot is restored. Instead of restoring a spell slot, the creature can give itself 1d10 Temporary Hit Points. Altering Fate: The creature uses its Reaction to give itself 1d10 bonus on the next ability check that is rolled within 1 minute. Starry Eyes: The stars shine on the eyes of the creature. It gains darkvision (30 ft.) for the next minute. Celestial Eyes: The creature is blessed with celestial sight. It has Advantage on Perception or Intelligence checks made within the next minute."
        }
        #tK54fS02cCcEryz4xzQSzTjV ^"Shocking Grasp" DEF {
            EXTENDS ^"Stat Block Feature"
            ^"Category" STRING "Action"
            ^"Description" STRING "Melee Spell Attack: +6 to hit, reach 5 ft, one creature. Hit: 4 (1d8) Lightning damage."
        }
    }
}

