EXTENSION "HistoricaArcanum_CoC_Professions" EXTENDS "Dnd5_5e_Core_Base" {
    NAME "Historica Arcanum: The City of Crescent - The Profession System"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-07-21"

#tXfbe7HiXLPYB0qugJDte2VP ^"The Bounty Hunter" DEF {
    EXTENDS ^"Profession"
    PROPERTIES {
        ^"Description" STRING "A life of chase, of high octane fights, and the thrill of bringing back your prey alive or dead; getting paid handsomely, and doing this for a living–You are a bounty hunter. You stalk your prey, prepare the best trap for the occasion, and strike your mark, with blades, chains, and all that is in your arsenal."
        ^"Overview" STRING "How to Play?\n\nAccept a bounty and you will be expected to turn in your target; either subdued somehow or as a corpse. A bounty hunt has four exciting steps: tracking, preparing, confronting, and bringing back the bounty. Each step is ladened with high danger, so make sure you are ready for this way of life!\n\nClimbing the Ranks\n\nFor each bounty you turn in, you gain PEX (Profession Experience), and when you gather enough PEX, you will advance in the ranks of the bounty hunters. When you reach Rank 2 as a bounty hunter, you will have to be specialized in one way of hunting."
        ^"Aspiring Background" STRING "You decide to spend your life as a bounty hunter, and by taking this background, you can start this profession at level 1 with 0 PEX as an Apprentice Bounty Hunter."
    }
    PEX_TABLE {
        #t5vy1yj8w0iDiSRuUnfRJApx ^"The Bounty Hunter — CR 1/8" DEF {
            EXTENDS ^"PEX Award"
            ^"Challenge Rating" STRING "1/8"
            ^"PEX" INTEGER 1
        }
        #tbA5WZLwV4W6bpSm6tdyfFyU ^"The Bounty Hunter — CR 1/4" DEF {
            EXTENDS ^"PEX Award"
            ^"Challenge Rating" STRING "1/4"
            ^"PEX" INTEGER 2
        }
        #tUabsiBOr4n2gdPdrKY3XZCz ^"The Bounty Hunter — CR 1/2" DEF {
            EXTENDS ^"PEX Award"
            ^"Challenge Rating" STRING "1/2"
            ^"PEX" INTEGER 3
        }
        #ttNZeUAM6pagh6ivMNoNlt8u ^"The Bounty Hunter — CR 1" DEF {
            EXTENDS ^"PEX Award"
            ^"Challenge Rating" STRING "1"
