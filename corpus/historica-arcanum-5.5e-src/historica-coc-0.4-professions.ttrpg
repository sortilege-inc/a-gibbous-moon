            EXTENDS ^"PEX Award"
            ^"Challenge Rating" STRING "5"
            ^"PEX" INTEGER 25
        }
        #tkqMkJYhlsDO9OrN27KdLnFJ ^"The Bounty Hunter — CR 6" DEF {
            EXTENDS ^"PEX Award"
            ^"Challenge Rating" STRING "6"
